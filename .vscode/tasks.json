{
	"version": "2.0.0",
	"options": {
		"cwd": "${workspaceFolder}",
		"env": {
			"DOTFILES": "${workspaceFolder}"
		}
	},
	"presentation": {
		"reveal": "always",
		"panel": "dedicated",
		"focus": true,
		"clear": false,
		"showReuseMessage": true
	},
	"problemMatcher": [],
	"tasks": [
		{
			"label": "Dotfiles: Bootstrap",
			"type": "process",
			"command": "bash",
			"args": [
				"${workspaceFolder}${/}bootstrap.sh"
			]
		},
		{
			"label": "Bash: Install bashrc",
			"type": "process",
			"command": "bash",
			"args": [
				"${workspaceFolder}${/}bash${/}bashrc-install.sh"
			]
		},
		{
			"label": "Git: Install configuration",
			"type": "process",
			"command": "bash",
			"args": [
				"${workspaceFolder}${/}git${/}git-config.sh"
			]
		},
		{
			"label": "Proton: Install Pass CLI",
			"type": "process",
			"command": "bash",
			"args": [
				"${workspaceFolder}${/}proton${/}install-proton-pass-cli.sh"
			]
		}
	]
}